# Portalbeveiliging. Gebruik minimaal 32 willekeurige tekens en roteer bij vermoeden van lekken.
PORTAL_SESSION_SECRET=
PORTAL_SESSION_HOURS=8
PORTAL_ORIGIN=http://localhost:3000

# Genereer passwordHash met: npm run auth:hash -- "een-lang-uniek-wachtwoord"
# Verhoog sessionVersion om alle bestaande sessies van een gebruiker direct ongeldig te maken.
# Vervang iedere voorbeeldhash door een afzonderlijke bcrypt-hash. Accountnamen zijn hoofdletterongevoelig.
PORTAL_USERS_JSON=[{"id":"jorn","login":"jorn","displayName":"Jorn","tenantId":"inco-source","role":"editor","passwordHash":"VUL_JORNS_BCRYPT_HASH_IN","sessionVersion":1,"active":true},{"id":"hidde","login":"hidde","displayName":"Hidde","tenantId":"inco-source","role":"editor","passwordHash":"VUL_HIDDES_BCRYPT_HASH_IN","sessionVersion":1,"active":true},{"id":"erik","login":"erik","displayName":"Erik","tenantId":"inco-source","role":"admin","passwordHash":"VUL_ERIKS_BCRYPT_HASH_IN","sessionVersion":1,"active":true}]

# demo = tenantgebonden browser-testdata; database = centrale Postgres-opslag met RLS en auditlog.
# Gebruik demo nooit voor echte bedrijfsgegevens. Productie kiest bij ontbrekende waarde fail-closed voor database.
PORTAL_DATA_MODE=demo
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SSL=require

# Alleen server-side gebruiken. Nooit als NEXT_PUBLIC_-variabele instellen.
OPENAI_API_KEY=

# Goedkoop standaardmodel voor statusvragen en SOP-opzoekwerk.
OPENAI_MODEL=gpt-5.6-luna

# Harde app-remmen voor de eerste testversie.
COPILOT_REQUESTS_PER_10_MINUTES=20
COPILOT_REQUESTS_PER_24_HOURS=100
COPILOT_MAX_REQUEST_CHARACTERS=250000

# Odoo 19 JSON-2, uitsluitend read-only preview. Gebruik een dedicated bot-user met minimale rechten.
ODOO_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_COMPANY_ID=
# Optioneel: bevestigde veldlijsten uit de dynamische /doc-pagina van de eigen Odoo-database.
ODOO_ARTICLE_FIELDS_JSON=
ODOO_SHIPMENT_FIELDS_JSON=
